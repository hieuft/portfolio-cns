---
import Bars from "./Bars.astro"

import svgUnderline from '../assets/underline.svg'
import arrowCard from '../assets/arrow-card.svg'

const portfolio = [
  { 
    name: '1. Thao tác cơ bản với tệp tin và thư mục', desc: `Cấu trúc thư mục tối ưu và quy tắc đặt tên tệp`,
    cover: `https://raw.githubusercontent.com/hieuft/portfolio-cns/refs/heads/main/src/assets/thumbnails/thumbnail1.png`,
    link: `https://drive.google.com/file/d/1PhXyvqRWGXO1jIvg7J23t-re6Z1r584q/view?usp=drive_link`
  },
  { 
    name: '2. Tìm kiếm và đánh giá thông tin học thuật', desc: `Kết quả tìm kiếm học thuật bằng các toán tử nâng cao và bảng đánh giá nguồn tin đã thực hiện`,
    cover: `https://raw.githubusercontent.com/hieuft/portfolio-cns/refs/heads/main/src/assets/thumbnails/thumbnail2.png`,
    link: `https://drive.google.com/file/d/1I58OnFS7B5oBiqEIBDn9PzqvxecEA4r4/view?usp=drive_link`
  },
  { 
    name: '3. Viết Prompt hiệu quả cho các tác vụ học tập', desc: `So sánh chất lượng đầu ra giữa Prompt đơn giản và Prompt đã cải tiến với các AI khác nhau`,
    cover: `https://raw.githubusercontent.com/hieuft/portfolio-cns/refs/heads/main/src/assets/thumbnails/thumbnail3.png`,
    link: `https://drive.google.com/file/d/1hJv8wnoV7bs6hRl279J4exD_R2259j22/view?usp=drive_link`
  },
  { 
    name: '4. Sử dụng công cụ hợp tác trực tuyến cho dự án nhóm', desc: `Cách sử dụng công cụ quảng lý dự án nhóm và phối hợp trực tuyến`,
    cover: `https://raw.githubusercontent.com/hieuft/portfolio-cns/refs/heads/main/src/assets/thumbnails/thumbnail4.png`,
    link: `https://drive.google.com/file/d/1U0iH0GdY7p43rXXr6lzf_I8uZWq3SZ0Z/view?usp=drive_link`
  },
  { 
    name: '5. Sử dụng AI tạo sinh để hỗ trợ sáng tạo nội dung', desc: `Các sản phẩm nội dung số hoàn thiện được hỗ trợ bởi AI`,
    cover: `https://raw.githubusercontent.com/hieuft/portfolio-cns/refs/heads/main/src/assets/thumbnails/thumbnail5.png`,
    link: `https://drive.google.com/file/d/1SMf6JwMqJOnBhqU7JBr20aQtb9dFGwD7/view?usp=drive_link`
  },
  { 
    name: '6. Sử dụng AI có trách nhiệm trong học tập và nghiên cứu', desc: `Bộ nguyên tắc cá nhân về sử dụng AI có trách nhiệm dựa trên các nghiên cứu đã thực hiện`,
    cover: `https://raw.githubusercontent.com/hieuft/portfolio-cns/refs/heads/main/src/assets/thumbnails/thumbnail6.png`,
    link: `https://drive.google.com/file/d/1TX1WpvYin74fvCgrRf733hNHXJAUCEK_/view?usp=drive_link`
  },
]
---


<section class="py-25 space-y-10 px-5" id="work">
    <div class="max-w-md mx-auto relative ">
      <h1 class="text-4xl font-medium text-center">Các dự án của mình</h1>
      <img src={svgUnderline.src} alt="arrow" width="140" class="absolute left-50 -bottom-1" />
    </div>
  
    <div class="max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10"> 
      {portfolio.map(item => ( 
        <a href={item.link} target="_blank" class="flex flex-col bg-white p-5 group relative transition-all duration-200 hover:shadow-[4px_4px_0px_rgba(0,0,0,0.3)]">
          <div class="w-full h-[200px] overflow-hidden border-2">
           <img src={item.cover} alt="" class="w-full h-full object-cover" />
          </div>
          <div class="space-y-1 pt-4">
            <div class="flex pr-2">
              <h2 class="text-xl font-medium flex-1">{item.name}</h2>
              <img src={arrowCard.src} alt="arrow" width="25" />
            </div>
            <p class="mr-20">{item.desc}</p>
          </div>
          <Bars />
        </a>
      ))}
    </div>
</section>