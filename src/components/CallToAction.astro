---
import svgPinkStar from '../assets/pink-star.svg'
import Button from './Button.astro'

---


<section class="px-3" id="hire">
    <div class="max-w-3xl mx-auto bg-white text-center flex flex-col gap-4 border-3 shadow-[8px_8px_0px_rgba(0,0,0,0.3)]  relative p-10">
     <h1 class="text-3xl">Kết luận</h1>
     <p class="text-lg max-w-lg mx-auto">Portfolio này là kết quả của quá trình học tập và rèn luyện trong suốt học phần. Tôi sẽ tiếp tục cập nhật và hoàn thiện Portfolio trong tương lai để ghi lại những dự án, kỹ năng và thành tựu mới trên hành trình phát triển bản thân.</p>
     <div class="flex justify-center">
       <Button text={"Quay lại"} link={"#"} />
     </div>
     <img src={svgPinkStar.src} alt="svg" width="80" class="absolute -top-10 right-20" />
    </div>
  </section>